def scan_bash_functions(script_path: Path) -> List[str]:
    """扫描 bash 脚本中的所有函数定义"""
    functions = []
    try:
        content = script_path.read_text(errors='ignore')
        
        patterns = [
            r'^([a-zA-Z_][a-zA-Z0-9_]*)\s*\(\s*\)\s*\{',
            r'^function\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\(\s*\)\s*\{',
            r'^function\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\{',
        ]
        
        for line in content.split('\n'):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            
            for pattern in patterns:
                match = re.match(pattern, line)
                if match:
                    func_name = match.group(1)
                    if func_name not in ['if', 'then', 'else', 'fi', 'for', 'while', 'do', 'done',
                                        'case', 'esac', 'select', 'until']:
                        functions.append(func_name)
                    break
        
        seen = set()
        unique_functions = []
        for func in functions:
            if func not in seen:
                seen.add(func)
                unique_functions.append(func)
        
        return unique_functions
    except Exception as e:
        print(f"警告：扫描脚本 '{script_path}' 时出错 - {e}")
        return []

