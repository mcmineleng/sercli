        print("暂无子命令")
    
    function_dir = get_function_dir(package_name)
    if function_dir.exists():
        scripts = list(function_dir.iterdir())
        if scripts:
            print(f"函数文件 ({len(scripts)}个):")
            for script in scripts:
                print(f"  {script.name}")
    
    return 0

