def ensure_config_dirs():
    """确保配置目录存在"""
    MODULE_BASE_DIR.mkdir(parents=True, exist_ok=True)
    DATA_BASE_DIR.mkdir(parents=True, exist_ok=True)

def load_settings() -> dict:
    """加载设置"""
    try:
        if SETTINGS_FILE.exists():
            return json.loads(SETTINGS_FILE.read_text())
        else:
            return {}
    except:
        return {}

def save_settings(settings: dict):
    """保存设置"""
    SETTINGS_FILE.write_text(json.dumps(settings, indent=2, ensure_ascii=False))

def check_settings_exists() -> bool:
    """检查配置文件是否存在"""
    return SETTINGS_FILE.exists()

def load_manifest() -> dict:
    """加载包清单"""
    try:
        if MANIFEST_FILE.exists():
            return json.loads(MANIFEST_FILE.read_text())
    except:
        pass
    return {"list": []}

def save_manifest(manifest: dict):
    """保存包清单"""
    MANIFEST_FILE.write_text(json.dumps(manifest, indent=2, ensure_ascii=False))

def get_module_dir(package_name: str) -> Path:
    """获取模块目录路径"""
    return MODULE_BASE_DIR / package_name

def get_module_data_dir(package_name: str) -> Path:
    """获取模块数据目录路径"""
    return DATA_BASE_DIR / package_name

def get_module_json_path(package_name: str) -> Path:
    """获取模块的 module.json 路径"""
    return get_module_dir(package_name) / "module.json"

def get_function_dir(package_name: str) -> Path:
    """获取模块的 function 目录路径"""
    return get_module_dir(package_name) / "function"

def load_module(package_name: str) -> dict:
    """加载模块数据"""
    module_json = get_module_json_path(package_name)
    if not module_json.exists():
        return {}
    try:
        return json.loads(module_json.read_text())
    except:
        return {}

def save_module(package_name: str, data: dict):
    """保存模块数据"""
    module_dir = get_module_dir(package_name)
    module_dir.mkdir(parents=True, exist_ok=True)
    module_json = get_module_json_path(package_name)
    module_json.write_text(json.dumps(data, indent=2, ensure_ascii=False))

def validate_package_name(name: str) -> bool:
    """验证包名是否合法"""
    if not name:
        return False
    return all(c.isalnum() or c in ['_', '-', '.'] for c in name)

def safe_basename(path: str) -> str:
    """安全地获取路径的最后一段（basename）"""
    if not path:
        return ""
    basename = os.path.basename(path)
    if not basename:
        return path
    return basename

def version_compare(v1: str, v2: str) -> int:
    """
    比较两个版本号
    返回: -1 如果 v1 < v2, 0 如果 v1 == v2, 1 如果 v1 > v2
    支持语义化版本 1.0.0 和数字版本 10001
    """
    def parse_version(ver: str) -> Tuple[List[int], List[int]]:
        if '.' in ver:
            parts = ver.split('.')
            numeric_parts = []
            for p in parts:
                try:
                    numeric_parts.append(int(p))
                except ValueError:
                    numeric_parts.append(0)
            return numeric_parts, numeric_parts
        else:
            try:
                num = int(ver)
                return [num], [num]
            except ValueError:
                return [0], [0]
    
    parts1, _ = parse_version(v1)
    parts2, _ = parse_version(v2)
    
    max_len = max(len(parts1), len(parts2))
    parts1 += [0] * (max_len - len(parts1))
    parts2 += [0] * (max_len - len(parts2))
    
    for a, b in zip(parts1, parts2):
        if a < b:
            return -1
        if a > b:
            return 1
    
    return 0

def format_command_value(value: str) -> str:
    """格式化命令值显示"""
    if value.startswith("function."):
        return value
    return value

