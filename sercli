def cmd_check_sudo():
    """手动检查 sudo 配置"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    print("正在检查 sudo 配置...")
    cached = load_sudo_cache()
    print(f"缓存中的命令数: {len(cached)}")
    sudo_cmds = get_sudo_allowed_commands()
    print(f"sudo 允许的命令数: {len(sudo_cmds)}")
    
    only_in_sudo = sudo_cmds - cached
    only_in_cache = cached - sudo_cmds
    
    if only_in_sudo:
        print(f"\n⚠️ 发现 {len(only_in_sudo)} 个 sudo 中有但缓存中没有的命令:")
        for cmd in sorted(only_in_sudo)[:10]:
            print(f"  - {cmd}")
        if len(only_in_sudo) > 10:
            print(f"  ... 还有 {len(only_in_sudo) - 10} 个")
    
    if only_in_cache:
        print(f"\n缓存中有但 sudo 中没有的命令: {len(only_in_cache)} 个")
    
    if not only_in_sudo and not only_in_cache:
        print("\n✅ sudo 配置与缓存一致，没有发现异常")
    
    return 0

