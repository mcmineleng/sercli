def extract_commands_from_script(script_path: Path) -> Set[str]:
    """从脚本文件中提取所有可能执行的命令"""
    commands = set()
    try:
        content = script_path.read_text(errors='ignore')
        
        for line in content.split('\n'):
            line = line.strip()
            if not line or line.startswith('#') or ('=' in line.split()[0] if line.split() else False):
                continue
            
            if '|' in line:
                parts = line.split('|')
                first_cmd = parts[0].strip()
            else:
                first_cmd = line
            
            if first_cmd:
                words = first_cmd.split()
                if words:
                    cmd = words[0]
                    if cmd not in ['if', 'then', 'else', 'fi', 'for', 'while', 'do', 'done',
                                  'case', 'esac', 'function', '{', '}', '[', ']]', '!']:
                        commands.add(cmd)
        
        backtick_cmds = re.findall(r'`([^`]+)`', content)
        dollar_cmds = re.findall(r'\$\(([^)]+)\)', content)
        
        for cmd_str in backtick_cmds + dollar_cmds:
            words = cmd_str.strip().split()
            if words and words[0] not in ['if', 'then', 'else', 'fi']:
                commands.add(words[0])
    except Exception as e:
        print(f"警告：读取脚本 '{script_path}' 时出错 - {e}")
    
    return commands

def rebuild_sudo_cache():
    """重建 sudo 命令缓存"""
    all_commands = set()
    
    for module_dir in MODULE_BASE_DIR.iterdir():
        if not module_dir.is_dir():
            continue
        function_dir = module_dir / "function"
        if not function_dir.exists():
            continue
        
        for script_file in function_dir.iterdir():
            if script_file.is_file() and script_file.suffix in ['.sh', '.bash', '.py', '.pl', '']:
                if script_file.stat().st_mode & 0o111 or script_file.suffix in ['.sh', '.bash']:
                    commands = extract_commands_from_script(script_file)
                    all_commands.update(commands)
    
    sorted_commands = sorted(all_commands)
    SUDO_CACHE_FILE.write_text('\n'.join(sorted_commands) + '\n')
    return all_commands

def load_sudo_cache() -> Set[str]:
    """加载 sudo 命令缓存"""
    if not SUDO_CACHE_FILE.exists():
        return set()
    try:
        content = SUDO_CACHE_FILE.read_text().strip()
        if not content:
            return set()
        return set(content.split('\n'))
    except:
        return set()

def get_sudo_allowed_commands() -> Set[str]:
    """获取当前用户被允许的 sudo 命令"""
    allowed_commands = set()
    try:
        result = subprocess.run(
            ['sudo', '-l', '--json'],
            capture_output=True,
            text=True,
            timeout=30
        )
        if result.returncode != 0:
            return allowed_commands
        
        try:
            sudo_data = json.loads(result.stdout)
        except json.JSONDecodeError:
            return allowed_commands
        
        def extract_commands_from_json(data, commands_set):
            if isinstance(data, dict):
                for key, value in data.items():
                    if key in ['command', 'commands']:
                        if isinstance(value, str):
                            cmd = value.split()[0] if value.split() else ''
                            if cmd:
                                commands_set.add(cmd)
                        elif isinstance(value, list):
                            for item in value:
                                if isinstance(item, str):
                                    cmd = item.split()[0] if item.split() else ''
                                    if cmd:
                                        commands_set.add(cmd)
                                elif isinstance(item, dict):
                                    extract_commands_from_json(item, commands_set)
                    elif isinstance(value, (dict, list)):
                        extract_commands_from_json(value, commands_set)
            elif isinstance(data, list):
                for item in data:
                    extract_commands_from_json(item, commands_set)
        
        extract_commands_from_json(sudo_data, allowed_commands)
    except:
        pass
    return allowed_commands

def check_sudo_violations() -> List[str]:
    """检查 sudo 权限违规"""
    cached_commands = load_sudo_cache()
    sudo_commands = get_sudo_allowed_commands()
    if not sudo_commands:
        return []
    violations = sudo_commands - cached_commands
    return sorted(violations)

def handle_sudo_violations(violations: List[str], operation_desc: str = ""):
    """处理 sudo 权限违规"""
    if not violations:
        return True
    
    settings = load_settings()
    force_mode = settings.get("force", "off")
    
    if force_mode == "off":
        return True
    
    violation_msg = f"发现 {len(violations)} 个潜在的越权 sudo 命令:\n"
    for cmd in violations:
        violation_msg += f"  - {cmd}\n"
    
    if force_mode == "true":
        print(f"错误：检测到 sudo 配置中存在未授权的命令！")
        print(violation_msg)
        print("程序已终止，请联系管理员审查 sudo 配置。")
        return False
    elif force_mode == "false":
        log_entry = f"[{datetime.now().isoformat()}] {operation_desc}\n"
        log_entry += f"发现潜在的越权 sudo 命令:\n"
        for cmd in violations:
            log_entry += f"  {cmd}\n"
        log_entry += "\n"
        with open(VIOLATIONS_LOG, "a") as f:
            f.write(log_entry)
        print(f"警告：检测到 sudo 配置变更！")
        print(violation_msg)
        print(f"已记录到日志文件: {VIOLATIONS_LOG}")
        return True
    else:
        return True

