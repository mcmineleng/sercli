def main():
    """主函数"""
    ensure_config_dirs()
    
    if len(sys.argv) < 2:
        print_usage()
        return 1
    
    env_module = os.environ.get("MODULE_NAME", "")
    invoked_as = safe_basename(sys.argv[0])
    
    first_arg = sys.argv[1]
    
    # ========== 命令分发 ==========
    
    if first_arg == "init":
        return cmd_init()
    
    if first_arg == "create" and len(sys.argv) >= 3 and sys.argv[2] in ["mod", "module"]:
        if len(sys.argv) < 4:
            print("错误：请指定模块名")
            return 1
        return cmd_create_module(sys.argv[3])
    
    if first_arg == "delete" and len(sys.argv) >= 3 and sys.argv[2] in ["mod", "module"]:
        if len(sys.argv) < 4:
            print("错误：请指定模块名")
            return 1
        return cmd_delete_module(sys.argv[3])
    
    if first_arg == "set" and len(sys.argv) >= 4 and sys.argv[2] in ["cmd", "command"]:
        if len(sys.argv) < 5:
            print("错误：请指定模块名、子命令名和值")
            return 1
        module_name = sys.argv[3]
        eq_parts = sys.argv[4].split("=", 1)
        if len(eq_parts) != 2:
            print("错误：格式错误，应为 <子命令>=<值>")
            return 1
        subcommand = eq_parts[0]
        value = eq_parts[1]
        return cmd_set_command(module_name, subcommand, value)
    
    if first_arg == "set" and len(sys.argv) >= 3 and sys.argv[2] == "repo":
        if len(sys.argv) < 4:
            print("错误：请指定仓库地址")
            return 1
        return cmd_set_repo(sys.argv[3])
    
    if first_arg == "set" and len(sys.argv) >= 3 and sys.argv[2] == "shell":
        if len(sys.argv) < 4:
            print("错误：请指定 shell 解释器路径")
            return 1
        return cmd_set_shell(sys.argv[3])
    
    if first_arg == "delete" and len(sys.argv) >= 4 and sys.argv[2] in ["cmd", "command"]:
        if len(sys.argv) < 5:
            print("错误：请指定模块名和子命令名")
            return 1
        return cmd_delete_command(sys.argv[3], sys.argv[4])
    
    if first_arg == "import" and len(sys.argv) >= 4 and sys.argv[2] == "sh":
        if len(sys.argv) < 5:
            print("错误：请指定模块名和脚本路径")
            return 1
        module_name = sys.argv[3]
        script_path = sys.argv[4]
        auto_create = True
        if len(sys.argv) >= 6:
            if sys.argv[5] in ["--nocmd", "--nocommand"]:
                auto_create = False
        return cmd_import_sh(module_name, script_path, auto_create)
    
    if first_arg == "import" and len(sys.argv) >= 4 and sys.argv[2] in ["cmd", "command"]:
        if len(sys.argv) < 5:
            print("错误：请指定模块名和导入参数")
            return 1
        module_name = sys.argv[3]
        eq_parts = sys.argv[4].split("=", 1)
        if len(eq_parts) != 2:
            print("错误：格式错误，应为 <子命令>=<脚本路径>")
            return 1
        subcommand = eq_parts[0]
        script_path = eq_parts[1]
        return cmd_import_cmd(module_name, subcommand, script_path)
    
    if first_arg == "set" and len(sys.argv) >= 3 and sys.argv[2] == "sort":
        if len(sys.argv) < 4:
            print("错误：请指定排序模式")
            return 1
        return cmd_set_sort(sys.argv[3])
    
    if first_arg == "set" and len(sys.argv) >= 3 and sys.argv[2] == "redirect":
        if len(sys.argv) < 4:
            print("错误：请指定数值")
            return 1
        return cmd_set_redirect(sys.argv[3])
    
    if first_arg == "set" and len(sys.argv) >= 3 and sys.argv[2] == "force":
        if len(sys.argv) < 4:
            print("错误：请指定模式")
            return 1
        return cmd_set_force(sys.argv[3])
    
    if first_arg == "check" and len(sys.argv) >= 3 and sys.argv[2] == "sudo":
        return cmd_check_sudo()
    
    if first_arg == "rebuild" and len(sys.argv) >= 3 and sys.argv[2] == "cache":
        return cmd_rebuild_cache()
    
    if first_arg == "update":
        return cmd_update()
    
    if first_arg == "add":
        if len(sys.argv) < 3:
            print("错误：请指定要安装的包名")
            return 1
        return cmd_add(sys.argv[2:])
    
    if first_arg == "upgrade":
        if len(sys.argv) >= 3:
            return cmd_upgrade(sys.argv[2:])
        else:
            return cmd_upgrade(None)
    
    if first_arg == "offupdate":
        if len(sys.argv) < 3:
            print("错误：请指定要暂停更新的包名")
            return 1
        return cmd_offupdate(sys.argv[2:])
    
    if first_arg == "onupdate":
        if len(sys.argv) < 3:
            print("错误：请指定要恢复更新的包名")
            return 1
        return cmd_onupdate(sys.argv[2:])
    
    if first_arg == "list" and len(sys.argv) >= 3 and sys.argv[2] in ["cmd", "command"]:
        pattern = sys.argv[3] if len(sys.argv) >= 4 else None
        return cmd_list_command(pattern)
    
    if first_arg == "list" and len(sys.argv) >= 3 and sys.argv[2] in ["mod", "module"]:
        return cmd_list_module()
    
    if first_arg == "info" and len(sys.argv) >= 3:
        return cmd_info(sys.argv[2])
    
    if first_arg in ["help", "--help", "-h"]:
        print_usage()
        return 0
    
    # ========== 执行模式 ==========
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    sort_mode = load_settings().get("sort", "module")
    
    if env_module:
        subcommand = first_arg
        args = sys.argv[2:] if len(sys.argv) > 2 else []
        return cmd_execute(env_module, subcommand, args)
    
    if sort_mode == "command" and len(sys.argv) >= 3:
        subcommand = first_arg
        module_name = sys.argv[2]
        args = sys.argv[3:] if len(sys.argv) > 3 else []
        return cmd_execute(module_name, subcommand, args)
    
    if len(sys.argv) >= 3:
        module_name = first_arg
        subcommand = sys.argv[2]
        args = sys.argv[3:] if len(sys.argv) > 3 else []
        return cmd_execute(module_name, subcommand, args)
    
    print(f"错误：未知命令 '{first_arg}'")
    print("使用 'sercli help' 查看帮助")
    return 1

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\n已退出 sercli")
        sys.exit(0)
    except Exception as e:
        print(f"错误：{e}")
        sys.exit(1)