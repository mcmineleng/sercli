def cmd_set_command(package_name: str, subcommand: str, value: str):
    """设置子命令"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    if not subcommand:
        print("错误：子命令名不能为空")
        return 1
    
    module_data = load_module(package_name)
    if not module_data:
        print(f"错误：模块 '{package_name}' 不存在")
        return 1
    
    if value.upper() == "NULL":
        commands = get_commands_from_module(module_data)
        if subcommand in commands:
            module_data["command"] = [item for item in module_data["command"] if subcommand not in item]
            save_module(package_name, module_data)
            print(f"已删除子命令 '{package_name}.{subcommand}'")
        else:
            print(f"子命令 '{package_name}.{subcommand}' 不存在")
        return 0
    
    source = module_data.get("source", "local")
    if source == "repo":
        module_data["source"] = "noupdate"
        print(f"注意：模块 '{package_name}' 来源为 repo，修改后已变为 noupdate 状态")
    
    if value.startswith("function."):
        ref = value[len("function."):]
        if '(' in ref:
            if not ref.endswith(')'):
                print(f"错误：无效的 function 引用格式 '{value}'")
                return 1
            file_part = ref[:ref.index('(')]
            func_part = ref[ref.index('(')+1:-1]
            if not file_part or not func_part:
                print(f"错误：无效的 function 引用格式 '{value}'")
                return 1
        else:
            if not ref:
                print(f"错误：无效的 function 引用格式 '{value}'")
                return 1
    
    commands = get_commands_from_module(module_data)
    found = False
    for i, item in enumerate(module_data["command"]):
        if subcommand in item:
            module_data["command"][i] = {subcommand: value}
            found = True
            break
    
    if not found:
        module_data["command"].append({subcommand: value})
    
    save_module(package_name, module_data)
    print(f"成功设置子命令: '{package_name}.{subcommand}' = '{value}'")
    return 0

