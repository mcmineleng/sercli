def download_file(url: str, dest_path: Path) -> bool:
    """下载文件到指定路径"""
    try:
        print(f"正在下载: {url}")
        with tempfile.NamedTemporaryFile(delete=False) as tmp_file:
            tmp_path = Path(tmp_file.name)
        
        urllib.request.urlretrieve(url, str(tmp_path))
        shutil.move(str(tmp_path), str(dest_path))
        print(f"下载完成: {dest_path}")
        return True
    except Exception as e:
        print(f"下载失败: {e}")
        if 'tmp_path' in locals() and tmp_path.exists():
            tmp_path.unlink()
        return False

def extract_archive(archive_path: Path, dest_dir: Path) -> bool:
    """解压压缩包到目标目录"""
    archive_path = Path(archive_path)
    dest_dir = Path(dest_dir)
    dest_dir.mkdir(parents=True, exist_ok=True)
    
    ext = ''
    if str(archive_path).endswith('.tar.gz'):
        ext = '.tar.gz'
    elif str(archive_path).endswith('.tar'):
        ext = '.tar'
    elif str(archive_path).endswith('.zip'):
        ext = '.zip'
    elif str(archive_path).endswith('.7z'):
        ext = '.7z'
    else:
        print(f"错误：不支持的压缩格式 '{archive_path}'")
        return False
    
    try:
        if ext == '.tar.gz':
            import tarfile
            with tarfile.open(archive_path, 'r:gz') as tar:
                tar.extractall(dest_dir)
        elif ext == '.tar':
            import tarfile
            with tarfile.open(archive_path, 'r') as tar:
                tar.extractall(dest_dir)
        elif ext == '.zip':
            import zipfile
            with zipfile.ZipFile(archive_path, 'r') as zip_ref:
                zip_ref.extractall(dest_dir)
        elif ext == '.7z':
            result = subprocess.run(
                ['7z', 'x', str(archive_path), f'-o{dest_dir}', '-y'],
                capture_output=True,
                text=True
            )
            if result.returncode != 0:
                print(f"7z 解压失败: {result.stderr}")
                return False
        else:
            return False
        
        print(f"解压完成: {dest_dir}")
        return True
    except Exception as e:
        print(f"解压失败: {e}")
        return False

def install_package(package_name: str, archive_url: str) -> bool:
    """安装包 - 使用覆盖方式更新"""
    if not validate_package_name(package_name):
        print(f"错误：无效的包名 '{package_name}'")
        return False
    
    with tempfile.TemporaryDirectory() as tmpdir:
        tmp_path = Path(tmpdir)
        
        archive_filename = urllib.parse.urlparse(archive_url).path.split('/')[-1]
        if not archive_filename:
            archive_filename = f"{package_name}.tar.gz"
        
        archive_path = tmp_path / archive_filename
        if not download_file(archive_url, archive_path):
            return False
        
        extract_dir = tmp_path / "extract"
        if not extract_archive(archive_path, extract_dir):
            return False
        
        module_json_path = extract_dir / "module.json"
        if not module_json_path.exists():
            print(f"错误：压缩包中缺少 module.json 文件")
            return False
        
        try:
            module_data = json.loads(module_json_path.read_text())
            if "package" not in module_data or module_data["package"] != package_name:
                print(f"错误：module.json 中的包名不匹配")
                return False
            if "command" not in module_data:
                print(f"错误：module.json 中缺少 command 字段")
                return False
            if "version" not in module_data:
                print(f"错误：module.json 中缺少 version 字段")
                return False
        except json.JSONDecodeError:
            print(f"错误：module.json 格式无效")
            return False
        
        target_dir = get_module_dir(package_name)
        if target_dir.exists():
            response = input(f"包 '{package_name}' 已存在，本次操作会更新它，是否继续 [Y/n]? ")
            if response.lower() not in ['', 'y', 'yes']:
                print("已取消安装")
                return False
        
        target_dir.mkdir(parents=True, exist_ok=True)
        
        shutil.copy2(module_json_path, target_dir / "module.json")
        
        src_function = extract_dir / "function"
        if src_function.exists() and src_function.is_dir():
            dst_function = target_dir / "function"
            if dst_function.exists():
                shutil.rmtree(dst_function)
            shutil.copytree(src_function, dst_function)
            print(f"已更新 function 目录")
        
        data_dir = get_module_data_dir(package_name)
        data_dir.mkdir(parents=True, exist_ok=True)
        
        print(f"包 '{package_name}' 安装/更新成功")
        return True

