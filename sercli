def cmd_update():
    """从中心服务器拉取包清单"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    settings = load_settings()
    repo_url = settings.get("repo", "")
    if not repo_url:
        print("错误：未配置中心服务器地址 (repo)")
        print("请在 settings.json 中设置 'repo' 字段")
        return 1
    
    manifest_url = repo_url.rstrip('/') + "/manifest.json"
    print(f"正在从 {manifest_url} 拉取清单...")
    
    try:
        with tempfile.NamedTemporaryFile(delete=False) as tmp_file:
            tmp_path = Path(tmp_file.name)
        
        urllib.request.urlretrieve(manifest_url, str(tmp_path))
        
        try:
            manifest_data = json.loads(tmp_path.read_text())
            if "list" not in manifest_data:
                print("错误：清单格式无效，缺少 'list' 字段")
                return 1
        except json.JSONDecodeError as e:
            print(f"错误：清单格式无效 - {e}")
            return 1
        
        shutil.move(str(tmp_path), str(MANIFEST_FILE))
        print(f"清单更新成功，共 {len(manifest_data['list'])} 个包")
        return 0
    except Exception as e:
        print(f"更新失败: {e}")
        return 1

def cmd_add(package_names: List[str]):
    """安装一个或多个包"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    if not package_names:
        print("错误：请指定要安装的包名")
        return 1
    
    manifest = load_manifest()
    if not manifest.get("list"):
        print("错误：清单为空，请先执行 'sercli update' 拉取清单")
        return 1
    
    package_map = {item["package"]: item["url"] for item in manifest["list"] if "package" in item and "url" in item}
    
    success = True
    for package_name in package_names:
        if package_name not in package_map:
            print(f"错误：包 '{package_name}' 不在清单中")
            success = False
            continue
        
        if not install_package(package_name, package_map[package_name]):
            success = False
    
    if success:
        settings = load_settings()
        force_mode = settings.get("force", "off")
        if force_mode != "off":
            rebuild_sudo_cache()
            violations = check_sudo_violations()
            handle_sudo_violations(violations, f"安装包 {' '.join(package_names)}")
        
        print("\n所有包安装完成")
        return 0
    else:
        return 1

def cmd_upgrade(package_names: Optional[List[str]] = None):
    """升级包"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    if package_names:
        manifest = load_manifest()
        if not manifest.get("list"):
            print("错误：清单为空，请先执行 'sercli update' 拉取清单")
            return 1
        
        package_map = {item["package"]: item["url"] for item in manifest["list"] if "package" in item and "url" in item}
        
        success = True
        for package_name in package_names:
            if package_name not in package_map:
                print(f"错误：包 '{package_name}' 不在清单中")
                success = False
                continue
            
            module_data = load_module(package_name)
            if not module_data:
                print(f"错误：模块 '{package_name}' 未安装")
                success = False
                continue
            
            source = module_data.get("source", "local")
            if source == "noupdate":
                print(f"跳过 '{package_name}' (已暂停更新)")
                continue
            if source == "local":
                print(f"跳过 '{package_name}' (本地模块)")
                continue
            
            latest_version = None
            for item in manifest["list"]:
                if item["package"] == package_name and "version" in item:
                    latest_version = item["version"]
                    break
            
            current_version = module_data.get("version", "0.0.0")
            if latest_version and version_compare(current_version, latest_version) >= 0:
                print(f"'{package_name}' 已是最新版本 ({current_version})")
                continue
            
            if not install_package(package_name, package_map[package_name]):
                success = False
        
        if success:
            settings = load_settings()
            force_mode = settings.get("force", "off")
            if force_mode != "off":
                rebuild_sudo_cache()
                violations = check_sudo_violations()
                handle_sudo_violations(violations, f"升级包 {' '.join(package_names)}")
            return 0
        else:
            return 1
    
    else:
        manifest = load_manifest()
        if not manifest.get("list"):
            print("错误：清单为空，请先执行 'sercli update' 拉取清单")
            return 1
        
        package_map = {item["package"]: item["url"] for item in manifest["list"] if "package" in item and "url" in item}
        
        packages_to_upgrade = []
        for module_dir in MODULE_BASE_DIR.iterdir():
            if not module_dir.is_dir():
                continue
            
            package_name = module_dir.name
            module_data = load_module(package_name)
            if not module_data:
                continue
            
            source = module_data.get("source", "local")
            if source != "repo":
                continue
            
            latest_version = None
            for item in manifest["list"]:
                if item["package"] == package_name and "version" in item:
                    latest_version = item["version"]
                    break
            
            current_version = module_data.get("version", "0.0.0")
            if latest_version and version_compare(current_version, latest_version) < 0:
                packages_to_upgrade.append(package_name)
            else:
                print(f"'{package_name}' 已是最新版本 ({current_version})")
        
        if not packages_to_upgrade:
            print("所有包已是最新版本")
            return 0
        
        print(f"发现 {len(packages_to_upgrade)} 个包需要升级:")
        for pkg in packages_to_upgrade:
            print(f"  - {pkg}")
        
        success = True
        for package_name in packages_to_upgrade:
            if package_name not in package_map:
                print(f"错误：包 '{package_name}' 不在清单中")
                success = False
                continue
            
            if not install_package(package_name, package_map[package_name]):
                success = False
        
        if success:
            settings = load_settings()
            force_mode = settings.get("force", "off")
            if force_mode != "off":
                rebuild_sudo_cache()
                violations = check_sudo_violations()
                handle_sudo_violations(violations, "全量升级")
            return 0
        else:
            return 1

def cmd_offupdate(package_names: List[str]):
    """暂停指定包的更新"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    if not package_names:
        print("错误：请指定要暂停更新的包名")
        return 1
    
    success = True
    for package_name in package_names:
        module_data = load_module(package_name)
        if not module_data:
            print(f"错误：模块 '{package_name}' 不存在")
            success = False
            continue
        
        if module_data.get("source") == "local":
            print(f"跳过 '{package_name}' (本地模块)")
            continue
        
        if module_data.get("source") == "noupdate":
            print(f"'{package_name}' 已暂停更新")
            continue
        
        module_data["source"] = "noupdate"
        save_module(package_name, module_data)
        print(f"已暂停 '{package_name}' 的更新")
    
    return 0 if success else 1

def cmd_onupdate(package_names: List[str]):
    """恢复指定包的更新"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    if not package_names:
        print("错误：请指定要恢复更新的包名")
        return 1
    
    success = True
    for package_name in package_names:
        module_data = load_module(package_name)
        if not module_data:
            print(f"错误：模块 '{package_name}' 不存在")
            success = False
            continue
        
        if module_data.get("source") == "local":
            print(f"跳过 '{package_name}' (本地模块)")
            continue
        
        if module_data.get("source") == "repo":
            print(f"'{package_name}' 已经是 repo 状态")
            continue
        
        module_data["source"] = "repo"
        save_module(package_name, module_data)
        print(f"已恢复 '{package_name}' 的更新")
    
    return 0 if success else 1

