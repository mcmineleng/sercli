def cmd_import_sh(package_name: str, script_path: str, auto_create: bool = True):
    """导入整个 shell 脚本"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    module_data = load_module(package_name)
    if not module_data:
        print(f"错误：模块 '{package_name}' 不存在")
        return 1
    
    source_path = Path(script_path).expanduser().resolve()
    if not source_path.exists():
        print(f"错误：找不到脚本文件 '{script_path}'")
        return 1
    
    if not source_path.is_file():
        print(f"错误：'{script_path}' 不是一个文件")
        return 1
    
    function_dir = get_function_dir(package_name)
    function_dir.mkdir(parents=True, exist_ok=True)
    target_name = source_path.name
    target_path = function_dir / target_name
    
    if target_path.exists():
        print(f"警告：目标文件已存在，将被覆盖: {target_path}")
    
    try:
        shutil.copy2(source_path, target_path)
        target_path.chmod(target_path.stat().st_mode | 0o111)
    except Exception as e:
        print(f"错误：复制脚本失败 - {e}")
        return 1
    
    print(f"成功导入脚本: '{source_path}' → '{target_path}'")
    
    if auto_create:
        functions = scan_bash_functions(target_path)
        if functions:
            print(f"发现 {len(functions)} 个函数:")
            for func in functions:
                print(f"  - {func}")
            
            commands = get_commands_from_module(module_data)
            created_count = 0
            for func in functions:
                if func in commands:
                    print(f"  跳过 '{func}' (已存在)")
                    continue
                if module_data.get("source") == "repo":
                    module_data["source"] = "noupdate"
                    print(f"注意：模块 '{package_name}' 来源为 repo，修改后已变为 noupdate 状态")
                module_data["command"].append({func: f"function.{target_name}({func})"})
                created_count += 1
            
            if created_count > 0:
                save_module(package_name, module_data)
                print(f"成功创建 {created_count} 个子命令")
            else:
                print("没有新的子命令需要创建")
        else:
            print("警告：未在脚本中发现任何函数定义")
    else:
        print("已跳过自动创建子命令（--nocmd 模式）")
    
    settings = load_settings()
    force_mode = settings.get("force", "off")
    if force_mode != "off":
        print("正在重建 sudo 命令缓存...")
        rebuild_sudo_cache()
        violations = check_sudo_violations()
        if not handle_sudo_violations(violations, f"导入脚本 {script_path} 到模块 {package_name}"):
            return 1
    
    return 0

