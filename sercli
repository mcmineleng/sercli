def cmd_list_command(pattern: Optional[str] = None):
    """列出所有可用命令"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    found_any = False
    
    for module_dir in sorted(MODULE_BASE_DIR.iterdir()):
        if not module_dir.is_dir():
            continue
        
        package_name = module_dir.name
        module_data = load_module(package_name)
        if not module_data:
            continue
        
        commands = get_commands_from_module(module_data)
        if not commands:
            continue
        
        if pattern:
            matched = {k: v for k, v in commands.items() if pattern in k}
            if matched:
                found_any = True
                source = module_data.get("source", "local")
                version = module_data.get("version", "0.0.0")
                print(f"\n模块: {package_name} (source: {source}, version: {version})")
                for cmd, val in sorted(matched.items()):
                    print(f"  {cmd} -> {format_command_value(val)}")
        else:
            found_any = True
            source = module_data.get("source", "local")
            version = module_data.get("version", "0.0.0")
            print(f"\n模块: {package_name} (source: {source}, version: {version})")
            for cmd, val in sorted(commands.items()):
                print(f"  {cmd} -> {format_command_value(val)}")
    
    if not found_any:
        if pattern:
            print(f"未找到匹配 '{pattern}' 的命令")
        else:
            print("暂无可用命令")
    
    return 0

