def print_usage():
    """打印使用帮助"""
    print("""sercli - 命令行工具

用法：
  sercli <命令> [参数...]
  sercli <模块名> <子命令>

模块管理：
  sercli create module <模块名>           创建模块
  
  sercli delete module <模块名>           删除模块
  
子命令管理：
  sercli set command <模块> <子命令>=<别名>           设定别名（指向同模块子命令）
  
  sercli set command <模块> <子命令>=function.<文件名>  设定子命令指向脚本文件（默认函数名与子命令相同）
  
  sercli set command <模块> <子命令>=function.<文件名>(<函数名>)  设定子命令指向脚本中的指定函数
  
  sercli set command <模块> <子命令>=NULL              删除子命令
  
  sercli delete command <模块> <子命令>                删除子命令

函数导入：
  sercli import function <模块> <子命令>=<脚本路径>     从脚本路径导入函数作为子命令
  
  示例：sercli import function nginx restart=./restart.sh

快速调用：
  sercli set module <模块名> link="<链接名>"           设置模块链接名，配合软链接使用（如 ngcli start）
  
  注：如无软链接权限，可使用 alias xxx="MODULE_NAME=xxx sercli"，无需 set module link

其他设置：
  sercli set sort module        模块在前（默认）
  sercli set sort command       命令在前
  sercli set redirect <数值>    设置重定向限制
  sercli set force true/false/off  设置严格模式

安全审计：
  sercli check sudo             检查 sudo 配置
  sercli rebuild cache          重建命令缓存

查询：
  sercli list command [匹配模式]  列出命令（支持匹配模式过滤）
  sercli list module             列出所有模块
  sercli info <模块名>           查看模块详细信息""")

def main():
    """主函数"""
    ensure_config_dirs()
    
    if len(sys.argv) < 2:
        print_usage()
        return 1
    
    env_module = os.environ.get("MODULE_NAME", "")
    invoked_as = safe_basename(sys.argv[0])
    
    # 尝试通过链接名匹配模块
    link_match = None
    if invoked_as != "sercli":
        for module_file in MODULES_DIR.glob("*.json"):
            module_data = load_module(module_file.stem)
            if module_data.get("__link__") == invoked_as:
                link_match = module_file.stem
                break
    
    first_arg = sys.argv[1]
    
    # ========== 命令分发 ==========
    
    # create module
    if first_arg == "create" and len(sys.argv) >= 3 and sys.argv[2] == "module":
        if len(sys.argv) < 4:
            print("错误：请指定模块名")
            return 1
        return cmd_create_module(sys.argv[3])
    
    # delete module
    if first_arg == "delete" and len(sys.argv) >= 3 and sys.argv[2] == "module":
        if len(sys.argv) < 4:
            print("错误：请指定模块名")
            return 1
        return cmd_delete_module(sys.argv[3])
    
    # set command
    if first_arg == "set" and len(sys.argv) >= 4 and sys.argv[2] == "command":
        if len(sys.argv) < 5:
            print("错误：请指定模块名、子命令名和值")
            return 1
        module_name = sys.argv[3]
        eq_parts = sys.argv[4].split("=", 1)
        if len(eq_parts) != 2:
            print("错误：格式错误，应为 <子命令>=<值>")
            return 1
        subcommand = eq_parts[0]
        value = eq_parts[1]
        return cmd_set_command(module_name, subcommand, value)
    
    # delete command
    if first_arg == "delete" and len(sys.argv) >= 4 and sys.argv[2] == "command":
        if len(sys.argv) < 5:
            print("错误：请指定模块名和子命令名")
            return 1
        return cmd_delete_command(sys.argv[3], sys.argv[4])
    
    # import function
    if first_arg == "import" and len(sys.argv) >= 4 and sys.argv[2] == "function":
        if len(sys.argv) < 5:
            print("错误：请指定模块名和导入参数")
            return 1
        module_name = sys.argv[3]
        eq_parts = sys.argv[4].split("=", 1)
        if len(eq_parts) != 2:
            print("错误：格式错误，应为 <子命令>=<脚本路径>")
            return 1
        subcommand = eq_parts[0]
        script_path = eq_parts[1]
        return cmd_import_function(module_name, subcommand, script_path)
    
    # set module link
    if first_arg == "set" and len(sys.argv) >= 5 and sys.argv[2] == "module" and "=" in sys.argv[4]:
        if len(sys.argv) < 5:
            print("错误：请指定模块名和链接名")
            return 1
        module_name = sys.argv[3]
        eq_parts = sys.argv[4].split("=", 1)
        if len(eq_parts) != 2 or eq_parts[0] != "link":
            print("错误：格式错误，应为 link=<链接名>")
            return 1
        link_name = eq_parts[1].strip('"').strip("'")
        return cmd_set_module_link(module_name, link_name)
    
    # set sort
    if first_arg == "set" and len(sys.argv) >= 4 and sys.argv[2] == "sort":
        if len(sys.argv) < 4:
            print("错误：请指定排序模式")
            return 1
        return cmd_set_sort(sys.argv[3])
    
    # set redirect
    if first_arg == "set" and len(sys.argv) >= 3 and sys.argv[2] == "redirect":
        if len(sys.argv) < 4:
            print("错误：请指定数值")
            return 1
        return cmd_set_redirect(sys.argv[3])
    
    # set force
    if first_arg == "set" and len(sys.argv) >= 3 and sys.argv[2] == "force":
        if len(sys.argv) < 4:
            print("错误：请指定模式")
            return 1
        return cmd_set_force(sys.argv[3])
    
    # check sudo
    if first_arg == "check" and len(sys.argv) >= 3 and sys.argv[2] == "sudo":
        return cmd_check_sudo()
    
    # rebuild cache
    if first_arg == "rebuild" and len(sys.argv) >= 3 and sys.argv[2] == "cache":
        return cmd_rebuild_cache()
    
    # list command
    if first_arg == "list" and len(sys.argv) >= 3 and sys.argv[2] == "command":
        pattern = sys.argv[3] if len(sys.argv) >= 4 else None
        return cmd_list_command(pattern)
    
    # list module
    if first_arg == "list" and len(sys.argv) >= 3 and sys.argv[2] == "module":
        return cmd_list_module()
    
    # info
    if first_arg == "info" and len(sys.argv) >= 3:
        return cmd_info(sys.argv[2])
    
    # help
    if first_arg in ["help", "--help", "-h"]:
        print_usage()
        return 0
    
    # ========== 执行模式 ==========
    sort_mode = load_settings().get("sort", "module")
    
    if link_match:
        return cmd_execute(link_match, first_arg)
    
    if env_module:
        return cmd_execute(env_module, first_arg)
    
    if sort_mode == "command" and len(sys.argv) >= 3:
        return cmd_execute(sys.argv[2], first_arg)
    
    if len(sys.argv) >= 3:
        return cmd_execute(first_arg, sys.argv[2])
    
    print(f"错误：未知命令 '{first_arg}'")
    print("使用 'sercli help' 查看帮助")
    return 1

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\n已退出 sercli")
        sys.exit(0)
    except Exception as e:
        print(f"错误：{e}")
        sys.exit(1)