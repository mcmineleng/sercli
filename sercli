def get_commands_from_module(module_data: dict) -> Dict[str, str]:
    """从模块数据中提取命令映射"""
    commands = {}
    if "command" in module_data and isinstance(module_data["command"], list):
        for item in module_data["command"]:
            if isinstance(item, dict):
                for key, value in item.items():
                    commands[key] = value
    return commands

def resolve_command(package_name: str, subcommand: str, depth: int = 0, max_depth: Optional[int] = None) -> Optional[str]:
    """解析命令别名链，返回最终的命令值"""
    if max_depth is None:
        settings = load_settings()
        max_depth = settings.get("redirect", 100)
    
    if max_depth == 0:
        return None
    
    if depth >= max_depth:
        print(f"警告：别名追踪深度超过限制 ({max_depth})，可能存在循环引用")
        return None
    
    module_data = load_module(package_name)
    if not module_data:
        return None
    
    commands = get_commands_from_module(module_data)
    if subcommand not in commands:
        return None
    
    value = commands[subcommand]
    
    if value.startswith("function."):
        return value
    
    if value in commands:
        return resolve_command(package_name, value, depth + 1, max_depth)
    
    if value in commands:
        return value
    else:
        print(f"错误：别名 '{value}' 指向的子命令不存在")
        return None

def execute_function(function_ref: str, args: Optional[List[str]] = None, package_name: Optional[str] = None) -> int:
    """
    执行函数调用
    格式: function.文件名.sh 或 function.文件名.sh(函数名)
    """
    ref = function_ref[len("function."):]
    
    func_name = None
    if '(' in ref and ref.endswith(')'):
        paren_idx = ref.index('(')
        file_part = ref[:paren_idx]
        func_name = ref[paren_idx+1:-1]
    else:
        file_part = ref
    
    found = False
    executed_cmd = None
    found_package = None
    
    if package_name:
        function_dir = get_function_dir(package_name)
        if function_dir.exists():
            script_path = function_dir / file_part
            if script_path.exists() and script_path.is_file():
                found = True
                executed_cmd = str(script_path)
                found_package = package_name
            else:
                script_path_sh = function_dir / f"{file_part}.sh"
                if script_path_sh.exists() and script_path_sh.is_file():
                    found = True
                    executed_cmd = str(script_path_sh)
                    found_package = package_name
    
    if not found:
        for module_dir in MODULE_BASE_DIR.iterdir():
            if not module_dir.is_dir():
                continue
            function_dir = module_dir / "function"
            if not function_dir.exists():
                continue
            
            script_path = function_dir / file_part
            if script_path.exists() and script_path.is_file():
                found = True
                executed_cmd = str(script_path)
                found_package = module_dir.name
                break
            
            script_path_sh = function_dir / f"{file_part}.sh"
            if script_path_sh.exists() and script_path_sh.is_file():
                found = True
                executed_cmd = str(script_path_sh)
                found_package = module_dir.name
                break
    
    if not found:
        print(f"错误：找不到函数文件 '{file_part}'")
        return 1
    
    settings = load_settings()
    shell_path = settings.get("shell", "")
    
    env = os.environ.copy()
    if found_package:
        env['MODULE_NAME'] = found_package
        env['MODULE_DIR'] = str(get_module_dir(found_package))
        env['MODULE_DATA_DIR'] = str(get_module_data_dir(found_package))
    
    cwd = get_module_dir(found_package) if found_package else None
    if cwd and not cwd.exists():
        cwd = None
    
    if func_name:
        if shell_path:
            shell_cmd = f"source '{executed_cmd}' && {func_name}"
            if args:
                quoted_args = ' '.join(shlex.quote(arg) for arg in args)
                shell_cmd += f" {quoted_args}"
            result = subprocess.run(
                [shell_path, "-c", shell_cmd],
                capture_output=False,
                text=True,
                env=env,
                cwd=cwd
            )
        else:
            shell_cmd = f"source '{executed_cmd}' && {func_name}"
            if args:
                quoted_args = ' '.join(shlex.quote(arg) for arg in args)
                shell_cmd += f" {quoted_args}"
            result = subprocess.run(
                ["bash", "-c", shell_cmd],
                capture_output=False,
                text=True,
                env=env,
                cwd=cwd
            )
        return result.returncode
    else:
        if shell_path:
            cmd = [shell_path, executed_cmd]
        else:
            cmd = ["bash", executed_cmd]
        if args:
            cmd.extend(args)
        result = subprocess.run(
            cmd,
            capture_output=False,
            text=True,
            env=env,
            cwd=cwd
        )
        return result.returncode

def cmd_execute(package_name: str, subcommand: str, args: Optional[List[str]] = None) -> int:
    """执行子命令"""
    if not check_settings_exists():
        print("错误：未初始化，请先执行 'sercli init'")
        return 1
    
    env = os.environ.copy()
    env['MODULE_NAME'] = package_name
    env['MODULE_DIR'] = str(get_module_dir(package_name))
    env['MODULE_DATA_DIR'] = str(get_module_data_dir(package_name))
    
    settings = load_settings()
    max_redirect = settings.get("redirect", 100)
    
    resolved = resolve_command(package_name, subcommand, max_depth=max_redirect if max_redirect > 0 else None)
    
    if resolved is None:
        print(f"错误：找不到命令 '{package_name}.{subcommand}'")
        return 1
    
    if resolved.startswith("function."):
        return execute_function(resolved, args, package_name)
    
    cmd_parts = shlex.split(resolved)
    if args:
        cmd_parts.extend(args)
    
    cwd = get_module_dir(package_name)
    if not cwd.exists():
        cwd = None
    
    result = subprocess.run(
        cmd_parts,
        capture_output=False,
        text=True,
        env=env,
        cwd=cwd
    )
    return result.returncode

