def cmd_init():
    """初始化 sercli 配置 - 交互式"""
    if check_settings_exists():
        response = input("配置文件已存在，是否覆盖 [y/N]? ")
        if response.lower() not in ['y', 'yes']:
            print("已取消初始化")
            return 1
    
    ensure_config_dirs()
    
    print("\n=== sercli 初始化配置 ===\n")
    print("提示：直接按回车使用默认值\n")
    
    current_settings = load_settings() if check_settings_exists() else {}
    
    # 1. 仓库地址
    default_repo = current_settings.get("repo", DEFAULT_SETTINGS["repo"])
    repo_input = input(f"中心服务器地址 (默认: {default_repo or '空'}): ").strip()
    repo_url = repo_input if repo_input else default_repo
    
    # 2. 重定向限制
    default_redirect = current_settings.get("redirect", DEFAULT_SETTINGS["redirect"])
    redirect_input = input(f"重定向限制 (默认: {default_redirect}): ").strip()
    try:
        redirect_value = int(redirect_input) if redirect_input else default_redirect
        if redirect_value < 0:
            print("警告：重定向数值不能为负数，将使用默认值")
            redirect_value = default_redirect
    except ValueError:
        print(f"警告：无效的数值，将使用默认值 {default_redirect}")
        redirect_value = default_redirect
    
    # 3. 严格模式
    default_force = current_settings.get("force", DEFAULT_SETTINGS["force"])
    force_options = {"true": "严格模式", "false": "宽容模式", "off": "完全关闭"}
    force_input = input(f"严格模式 (true/false/off, 默认: {default_force}): ").strip().lower()
    if force_input in ["true", "false", "off"]:
        force_mode = force_input
    else:
        print(f"警告：无效的严格模式，将使用默认值 '{default_force}'")
        force_mode = default_force
    
    # 4. 调用顺序
    default_sort = current_settings.get("sort", DEFAULT_SETTINGS["sort"])
    sort_input = input(f"调用顺序 (module/command, 默认: {default_sort}): ").strip().lower()
    if sort_input in ["module", "command"]:
        sort_mode = sort_input
    else:
        print(f"警告：无效的调用顺序，将使用默认值 '{default_sort}'")
        sort_mode = default_sort
    
    # 5. Shell 解释器
    default_shell = current_settings.get("shell", DEFAULT_SETTINGS["shell"])
    shell_input = input(f"Shell 解释器路径 (默认: {default_shell or 'bash'}): ").strip()
    shell_path = shell_input if shell_input else default_shell
    
    if shell_path:
        path_obj = Path(shell_path).expanduser().resolve()
        if not path_obj.exists():
            print(f"警告：路径 '{shell_path}' 不存在")
            use_anyway = input("是否继续使用该路径 [y/N]? ").strip().lower()
            if use_anyway not in ['y', 'yes']:
                shell_path = default_shell
        elif not path_obj.is_file():
            print(f"警告：'{shell_path}' 不是一个文件")
            use_anyway = input("是否继续使用该路径 [y/N]? ").strip().lower()
            if use_anyway not in ['y', 'yes']:
                shell_path = default_shell
    
    print("\n=== 配置摘要 ===")
    print(f"  仓库地址: {repo_url or '(未设置)'}")
    print(f"  重定向限制: {redirect_value}")
    print(f"  严格模式: {force_mode} ({force_options.get(force_mode, '未知')})")
    print(f"  调用顺序: {sort_mode}")
    print(f"  Shell 解释器: {shell_path or 'bash (默认)'}")
    
    print("\n是否保存以上配置?")
    confirm = input("[Y/n]: ").strip().lower()
    if confirm not in ['', 'y', 'yes']:
        print("已取消初始化")
        return 1
    
    settings = {
        "repo": repo_url,
        "redirect": redirect_value,
        "force": force_mode,
        "sort": sort_mode,
        "shell": shell_path
    }
    save_settings(settings)
    
    print(f"\n✅ 初始化成功！配置文件已保存: {SETTINGS_FILE}")
    print("\n接下来你可以:")
    print("  - 使用 'sercli create mod <模块名>' 创建模块")
    print("  - 使用 'sercli add <包名>' 安装远程包")
    print("  - 使用 'sercli set repo <URL>' 重新设置仓库地址")
    
    return 0
